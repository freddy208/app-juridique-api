generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Utilisateur {
  id                   String                @id @default(uuid())
  prenom               String
  nom                  String
  email                String                @unique
  motDePasse           String
  telephone            String? // ✅ ajouté
  adresse              String? // ✅ ajouté
  specialite           String? // ✅ ajouté
  barreau              String? // ✅ ajouté
  numeroPermis         String? // ✅ ajouté
  role                 RoleUtilisateur       @default(ASSISTANT)
  statut               StatutUtilisateur     @default(ACTIF)
  creeLe               DateTime              @default(now())
  modifieLe            DateTime              @updatedAt
  refreshToken         String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  archives             Archive[]
  correspondances      Correspondance[]
  documents            Document[]            @relation("DocumentsTeleverses")
  dossiers             Dossier[]             @relation("DossierResponsable")
  evenements           EvenementCalendrier[]
  journauxAudit        JournalAudit[]
  messages             MessageChat[]
  notes                Note[]
  tachesAssignees      Tache[]               @relation("AssigneTache")
  tachesCreees         Tache[]               @relation("CreateurTache")
  Commentaire          Commentaire[]
  ReactionMessage      ReactionMessage[]
  Notification         Notification[]
  Fichier              Fichier[]
  PerformanceAvocat    PerformanceAvocat[]
  Alerte               Alerte[]

  @@index([role])
  @@index([statut])
  @@index([role, statut])
  @@index([creeLe])
  @@map("Utilisateur")
}

model Client {
  id                  String                @id @default(uuid())
  prenom              String
  nom                 String
  nomEntreprise       String?
  telephone           String?
  email               String?
  adresse             String?
  statut              StatutClient          @default(ACTIF)
  creeLe              DateTime              @default(now())
  modifieLe           DateTime              @updatedAt
  correspondances     Correspondance[]
  dossiers            Dossier[]
  factures            Facture[]
  notes               Note[]
  DocumentIdentite    DocumentIdentite[]
  honoraires          Honoraire[]
  paiements           Paiement[]
  provisions          Provision[]
  chiffreAffaires     Decimal?              @default(0)
  statutVIP           Boolean               @default(false)
  derniereVisite      DateTime?
  CommunicationClient CommunicationClient[]
  Satisfaction        Satisfaction[]

  @@index([statutVIP])
  @@index([chiffreAffaires])
}

model Dossier {
  id               String                @id @default(uuid())
  numeroUnique     String                @unique
  clientId         String
  titre            String
  type             TypeDossier
  description      String?
  responsableId    String?
  statut           StatutDossier         @default(OUVERT)
  creeLe           DateTime              @default(now())
  modifieLe        DateTime              @updatedAt
  contentieux      Contentieux?
  contrat          Contrat?
  documents        Document[]
  client           Client                @relation(fields: [clientId], references: [id])
  responsable      Utilisateur?          @relation("DossierResponsable", fields: [responsableId], references: [id])
  evenements       EvenementCalendrier[]
  factures         Facture[]
  immobilier       Immobilier?
  messages         MessageChat[]
  notes            Note[]
  sinistreCorporel SinistreCorporel?
  sinistreMateriel SinistreMateriel?
  sinistreMortel   SinistreMortel?
  sport            Sport?
  taches           Tache[]
  Autre            Autre?

  procedures       Procedure[]
  honoraires       Honoraire[]
  depenses         Depense[]
  provisions       Provision[]
  jurisprudences   DossierJurisprudence[]
  documentsGeneres DocumentGenere[]
  valeurFinanciere Decimal?
  risqueJuridique  NiveauRisque?
  chancesSucces    Int? // Pourcentage 0-100
  Satisfaction     Satisfaction[]

  // Index pour les performances
  @@index([statut])
  @@index([type])
  @@index([clientId])
  @@index([responsableId])
  @@index([creeLe])
  @@index([modifieLe])
  @@index([statut, type])
  @@index([statut, creeLe])
  @@index([valeurFinanciere])
  @@index([risqueJuridique])
}

model SinistreCorporel {
  id              String          @id @default(uuid())
  dossierId       String          @unique
  dateAccident    DateTime?
  lieuAccident    String?
  numeroPvPolice  String?
  hopital         String?
  rapportMedical  String?
  graviteBlessure GraviteBlessure @default(MINEUR)
  assureur        String?
  numeroSinistre  String?
  temoins         Json?
  prejudice       Decimal?
  creeLe          DateTime        @default(now())
  modifieLe       DateTime        @updatedAt
  dossier         Dossier         @relation(fields: [dossierId], references: [id])
}

model SinistreMateriel {
  id                String             @id @default(uuid())
  dossierId         String             @unique
  dateAccident      DateTime?
  lieuAccident      String?
  categorieVehicule CategorieVehicule?
  marqueVehicule    String?
  modeleVehicule    String?
  immatriculation   String?
  numeroChassis     String?
  numeroPvPolice    String?
  assureur          String?
  numeroSinistre    String?
  estimationDegats  Decimal?
  photosUrls        Json?
  creeLe            DateTime           @default(now())
  modifieLe         DateTime           @updatedAt
  dossier           Dossier            @relation(fields: [dossierId], references: [id])
}

model SinistreMortel {
  id                    String    @id @default(uuid())
  dossierId             String    @unique
  dateDeces             DateTime?
  lieuDeces             String?
  certificatDeces       String?
  certificatMedicoLegal String?
  numeroPvPolice        String?
  causeDeces            String?
  ayantsDroit           Json?
  indemniteReclamee     Decimal?
  creeLe                DateTime  @default(now())
  modifieLe             DateTime  @updatedAt
  dossier               Dossier   @relation(fields: [dossierId], references: [id])
}

model Immobilier {
  id               String         @id @default(uuid())
  dossierId        String         @unique
  adresseBien      String?
  numeroTitre      String?
  numeroCadastre   String?
  referenceNotaire String?
  regimeFoncier    RegimeFoncier?
  surfaceM2        Decimal?
  typeLitige       String?
  chefQuartier     String?
  temoinsBornage   Json?
  creeLe           DateTime       @default(now())
  modifieLe        DateTime       @updatedAt
  dossier          Dossier        @relation(fields: [dossierId], references: [id])
}

model Sport {
  id               String    @id @default(uuid())
  dossierId        String    @unique
  club             String?
  competition      String?
  dateIncident     DateTime?
  instanceSportive String?
  referenceContrat String?
  sanctions        Json?
  creeLe           DateTime  @default(now())
  modifieLe        DateTime  @updatedAt
  dossier          Dossier   @relation(fields: [dossierId], references: [id])
}

model Contrat {
  id               String    @id @default(uuid())
  dossierId        String    @unique
  partieA          String?
  partieB          String?
  dateEffet        DateTime?
  dateExpiration   DateTime?
  valeurContrat    Decimal?
  loiApplicable    String?   @default("CAMEROUN")
  referenceNotaire String?
  contratUrl       String?
  creeLe           DateTime  @default(now())
  modifieLe        DateTime  @updatedAt
  dossier          Dossier   @relation(fields: [dossierId], references: [id])
}

model Contentieux {
  id              String           @id @default(uuid())
  dossierId       String           @unique
  numeroAffaire   String?
  tribunal        String?
  juridiction     String?
  demandeur       String?
  defendeur       String?
  avocatPlaignant String?
  avocatDefenseur String?
  etapeProcedure  EtapeProcedures? @default(INSTRUCTIVE)
  montantReclame  Decimal?
  datesAudiences  Json?
  depots          Json?
  rapportHussier  String?
  creeLe          DateTime         @default(now())
  modifieLe       DateTime         @updatedAt
  dossier         Dossier          @relation(fields: [dossierId], references: [id])
}

model Autre {
  id        String   @id @default(uuid())
  dossierId String   @unique
  champs    Json? // pour stocker dynamiquement les infos spécifiques
  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt
  dossier   Dossier  @relation(fields: [dossierId], references: [id])
}

model Document {
  id               String           @id @default(uuid())
  dossierId        String
  televersePar     String
  titre            String
  type             String
  url              String
  version          Int              @default(1)
  statut           StatutDocument   @default(ACTIF)
  creeLe           DateTime         @default(now())
  modifieLe        DateTime         @updatedAt
  dossier          Dossier          @relation(fields: [dossierId], references: [id])
  utilisateur      Utilisateur      @relation("DocumentsTeleverses", fields: [televersePar], references: [id])
  Commentaire      Commentaire[]
  documentsGeneres DocumentGenere[]
  taille           Int? // en bytes
  extension        String?
  indexeOCR        Boolean          @default(false)
  contenuOCR       String?          @db.Text
}

model Tache {
  id          String        @id @default(uuid())
  dossierId   String?
  titre       String
  description String?
  assigneeId  String?
  creeParId   String
  priorite    TachePriorite @default(MOYENNE) // <-- ajouté
  dateLimite  DateTime?
  statut      StatutTache   @default(A_FAIRE)
  creeLe      DateTime      @default(now())
  modifieLe   DateTime      @updatedAt
  assignee    Utilisateur?  @relation("AssigneTache", fields: [assigneeId], references: [id])
  createur    Utilisateur   @relation("CreateurTache", fields: [creeParId], references: [id])
  dossier     Dossier?      @relation(fields: [dossierId], references: [id])
  Commentaire Commentaire[]
}

model EvenementCalendrier {
  id          String          @id @default(uuid())
  dossierId   String?
  titre       String
  description String?
  debut       DateTime
  fin         DateTime
  creeParId   String
  statut      StatutEvenement @default(PREVU)
  creeLe      DateTime        @default(now())
  modifieLe   DateTime        @updatedAt
  createur    Utilisateur     @relation(fields: [creeParId], references: [id])
  dossier     Dossier?        @relation(fields: [dossierId], references: [id])
}

model MessageChat {
  id              String            @id @default(uuid())
  dossierId       String?
  expediteurId    String
  contenu         String
  statut          StatutMessage     @default(ENVOYE)
  creeLe          DateTime          @default(now())
  modifieLe       DateTime          @updatedAt
  dossier         Dossier?          @relation(fields: [dossierId], references: [id])
  expediteur      Utilisateur       @relation(fields: [expediteurId], references: [id])
  ReactionMessage ReactionMessage[]
}

model Facture {
  id            String        @id @default(uuid())
  dossierId     String?
  clientId      String
  numeroFacture String        @unique // <-- AJOUT : Numéro de facture unique
  montant       Decimal
  dateEcheance  DateTime
  payee         Boolean       @default(false)
  statut        StatutFacture @default(BROUILLON)
  creeLe        DateTime      @default(now())
  modifieLe     DateTime      @updatedAt
  client        Client        @relation(fields: [clientId], references: [id])
  dossier       Dossier?      @relation(fields: [dossierId], references: [id])
  paiements     Paiement[]
  montantHT     Decimal?
  montantTVA    Decimal?
  montantTTC    Decimal?
  solde         Decimal?
  relances      Json? // Historique des relances
}

model PermissionRole {
  id          String           @id @default(uuid())
  role        RoleUtilisateur
  module      String
  lecture     Boolean          @default(true)
  ecriture    Boolean          @default(false)
  suppression Boolean          @default(false)
  statut      StatutPermission @default(ACTIF)
  creeLe      DateTime         @default(now())
  modifieLe   DateTime         @updatedAt

  @@unique([role, module], name: "role_module_unique") // clé unique explicite
}

model JournalAudit {
  id             String      @id @default(uuid())
  utilisateurId  String
  action         String
  typeCible      String
  cibleId        String
  ancienneValeur Json?
  nouvelleValeur Json?
  creeLe         DateTime    @default(now())
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Archive {
  id          String        @id @default(uuid())
  typeObjet   String
  objetId     String
  archivePar  String
  dateArchive DateTime      @default(now())
  statut      StatutArchive @default(ARCHIVE)
  creeLe      DateTime      @default(now())
  modifieLe   DateTime      @updatedAt
  utilisateur Utilisateur   @relation(fields: [archivePar], references: [id])
}

model Correspondance {
  id            String               @id @default(uuid())
  clientId      String
  utilisateurId String
  type          TypeCorrespondance
  contenu       String?
  statut        StatutCorrespondance @default(ACTIF) // <- ajouter
  creeLe        DateTime             @default(now())
  modifieLe     DateTime             @updatedAt
  client        Client               @relation(fields: [clientId], references: [id])
  utilisateur   Utilisateur          @relation(fields: [utilisateurId], references: [id])
}

model Note {
  id            String      @id @default(uuid())
  clientId      String?
  dossierId     String?
  utilisateurId String
  contenu       String
  statut        StatutNote  @default(ACTIF) // <- ajouter
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt
  client        Client?     @relation(fields: [clientId], references: [id])
  dossier       Dossier?    @relation(fields: [dossierId], references: [id])
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Commentaire {
  id            String            @id @default(uuid())
  utilisateurId String
  documentId    String?
  tacheId       String?
  contenu       String
  statut        StatutCommentaire @default(ACTIF)
  creeLe        DateTime          @default(now())
  modifieLe     DateTime          @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  document    Document?   @relation(fields: [documentId], references: [id])
  tache       Tache?      @relation(fields: [tacheId], references: [id])
}

model ReactionMessage {
  id            String      @id @default(uuid())
  messageId     String
  utilisateurId String
  type          String // exemple: "LIKE", "LOVE", "HAHA", etc.
  creeLe        DateTime    @default(now())
  message       MessageChat @relation(fields: [messageId], references: [id])
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@unique([messageId, utilisateurId]) // Un utilisateur ne peut réagir qu'une fois par type sur un message
}

model Notification {
  id            String           @id @default(uuid())
  utilisateurId String
  titre         String
  message       String
  type          TypeNotification // INFO, ALERTE, URGENT
  lien          String? // lien vers ressource
  lu            Boolean          @default(false)
  creeLe        DateTime         @default(now())
  utilisateur   Utilisateur      @relation(fields: [utilisateurId], references: [id])
}

model DocumentIdentite {
  id            String               @id @default(uuid())
  clientId      String
  type          TypeDocumentIdentite
  url           String
  nomFichier    String
  tailleFichier Int
  publicId      String
  creeLe        DateTime             @default(now())
  modifieLe     DateTime             @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum TypeDocumentIdentite {
  CARTE_IDENTITE
  PASSEPORT
  PERMIS
  AUTRE
}

enum TypeNotification {
  INFO
  ALERTE
  URGENT
  TACHE
  MESSAGE
  FACTURE
  AUDIENCE
}

// Pour les fichiers (métadonnées Supabase)
model Fichier {
  id          String      @id @default(uuid())
  nom         String
  type        String // MIME type
  taille      Int // en bytes
  url         String // URL Supabase Storage
  bucket      String // nom bucket Supabase
  path        String // chemin dans bucket
  uploadePar  String
  creeLe      DateTime    @default(now())
  utilisateur Utilisateur @relation(fields: [uploadePar], references: [id])
}

// Pour les paramètres système
model Parametre {
  id        String   @id @default(uuid())
  cle       String   @unique
  valeur    String
  type      String // STRING, NUMBER, BOOLEAN, JSON
  modifieLe DateTime @updatedAt
}

enum StatutCommentaire {
  ACTIF
  SUPPRIME
}

enum RoleUtilisateur {
  ADMIN
  DG
  AVOCAT
  SECRETAIRE
  ASSISTANT
  JURISTE
  STAGIAIRE
}

enum TachePriorite {
  BASSE
  MOYENNE
  HAUTE
  URGENTE
}

enum StatutUtilisateur {
  ACTIF
  INACTIF
  SUSPENDU
}

enum StatutClient {
  ACTIF
  INACTIF
}

enum TypeDossier {
  SINISTRE_CORPOREL
  SINISTRE_MATERIEL
  SINISTRE_MORTEL
  IMMOBILIER
  SPORT
  CONTRAT
  CONTENTIEUX
  AUTRE
}

enum StatutDossier {
  OUVERT
  EN_COURS
  CLOS
  ARCHIVE
  SUPPRIME
  BROUILLON
}

enum GraviteBlessure {
  MINEUR
  MOYEN
  GRAVE
  CRITIQUE
}

enum CategorieVehicule {
  VOITURE
  MOTO
  CAMION
  AUTRE
}

enum RegimeFoncier {
  TITRE_FONCIER
  COUTUMIER
  BAIL
}

enum EtapeProcedures {
  INSTRUCTIVE
  AUDIENCE
  JUGEMENT
  APPEL
  EXECUTION
}

enum StatutDocument {
  ACTIF
  ARCHIVE
  SUPPRIME
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  TERMINEE
  SUPPRIME
}

enum StatutEvenement {
  PREVU
  TERMINE
  ANNULE
  SUPPRIME
}

enum StatutMessage {
  ENVOYE
  LU
  SUPPRIME
}

enum StatutFacture {
  BROUILLON
  ENVOYEE
  PAYEE
  EN_RETARD
  SUPPRIME
}

enum StatutPermission {
  ACTIF
  INACTIF
}

enum StatutArchive {
  ARCHIVE
  RESTAURE
}

enum TypeCorrespondance {
  APPEL
  EMAIL
  RENDEZ_VOUS
  AUTRE
}

enum StatutNote {
  ACTIF
  SUPPRIME
}

enum StatutCorrespondance {
  ACTIF
  SUPPRIME
}

// Gestion des honoraires et paiements
model Honoraire {
  id            String              @id @default(uuid())
  dossierId     String
  clientId      String
  montantHT     Decimal
  tauxTVA       Decimal             @default(19.25) // TVA camerounaise
  montantTVA    Decimal
  montantTTC    Decimal
  typeHonoraire TypeHonoraire
  modeCalcul    ModeCalculHonoraire
  baremeOHADA   String? // Référence barème OHADA
  dateEmission  DateTime            @default(now())
  dateEcheance  DateTime
  statut        StatutHonoraire     @default(EMIS)
  creeLe        DateTime            @default(now())
  modifieLe     DateTime            @updatedAt

  dossier   Dossier    @relation(fields: [dossierId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id])
  paiements Paiement[]

  @@index([dossierId])
  @@index([clientId])
  @@index([statut])
}

model Paiement {
  id           String         @id @default(uuid())
  honoraireId  String?
  factureId    String?
  clientId     String
  montant      Decimal
  modePaiement ModePaiement
  reference    String? // Référence MTN/Orange Money
  datePayement DateTime       @default(now())
  validePar    String?
  statut       StatutPaiement @default(EN_ATTENTE)
  creeLe       DateTime       @default(now())
  modifieLe    DateTime       @updatedAt

  honoraire Honoraire? @relation(fields: [honoraireId], references: [id])
  facture   Facture?   @relation(fields: [factureId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([statut])
}

model Depense {
  id             String           @id @default(uuid())
  dossierId      String?
  categorie      CategorieDepense
  montant        Decimal
  description    String
  dateDepense    DateTime
  beneficiaire   String?
  referencePiece String?
  validePar      String?
  statut         StatutDepense    @default(EN_ATTENTE)
  creeLe         DateTime         @default(now())
  modifieLe      DateTime         @updatedAt

  dossier Dossier? @relation(fields: [dossierId], references: [id])

  @@index([dossierId])
  @@index([categorie])
}

model Provision {
  id            String          @id @default(uuid())
  dossierId     String
  clientId      String
  montant       Decimal
  solde         Decimal
  dateProvision DateTime        @default(now())
  statut        StatutProvision @default(ACTIVE)
  creeLe        DateTime        @default(now())
  modifieLe     DateTime        @updatedAt

  dossier    Dossier              @relation(fields: [dossierId], references: [id])
  client     Client               @relation(fields: [clientId], references: [id])
  mouvements MouvementProvision[]

  @@index([dossierId])
  @@index([clientId])
}

model MouvementProvision {
  id          String        @id @default(uuid())
  provisionId String
  type        TypeMouvement // DEBIT, CREDIT
  montant     Decimal
  description String
  soldeApres  Decimal
  creeLe      DateTime      @default(now())

  provision Provision @relation(fields: [provisionId], references: [id])

  @@index([provisionId])
}

enum TypeHonoraire {
  FORFAITAIRE
  AU_RESULTAT
  HORAIRE
  MIXTE
}

enum ModeCalculHonoraire {
  BAREME_OHADA
  ACCORD_LIBRE
  CONVENTION
}

enum StatutHonoraire {
  EMIS
  PARTIELLEMENT_PAYE
  PAYE
  ANNULE
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  MTN_MONEY
  ORANGE_MONEY
  CARTE_BANCAIRE
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  REJETE
  ANNULE
}

enum CategorieDepense {
  FRAIS_JUSTICE
  HUISSIER
  DEPLACEMENT
  EXPERTISE
  PHOTOCOPIE
  TIMBRE
  HONORAIRES_TIERS
  AUTRE
}

enum StatutDepense {
  EN_ATTENTE
  APPROUVE
  REMBOURSE
  REJETE
}

enum StatutProvision {
  ACTIVE
  EPUISEE
  RESTITUEE
}

enum TypeMouvement {
  DEBIT
  CREDIT
}

model Jurisprudence {
  id            String              @id @default(uuid())
  numeroArret   String              @unique
  juridiction   JuridictionCameroun
  dateDecision  DateTime
  parties       String
  matiere       MatiereDroit
  motsCles      String[]
  resume        String
  texteIntegral String              @db.Text
  sensDecision  SensDecision
  reference     String?
  documentUrl   String?
  creeLe        DateTime            @default(now())
  modifieLe     DateTime            @updatedAt

  dossiers DossierJurisprudence[]

  @@index([juridiction])
  @@index([matiere])
  @@index([dateDecision])
}

model DossierJurisprudence {
  id              String   @id @default(uuid())
  dossierId       String
  jurisprudenceId String
  pertinence      Int      @default(5) // 1-10
  noteUtilisateur String?
  creeLe          DateTime @default(now())

  dossier       Dossier       @relation(fields: [dossierId], references: [id])
  jurisprudence Jurisprudence @relation(fields: [jurisprudenceId], references: [id])

  @@unique([dossierId, jurisprudenceId])
}

enum JuridictionCameroun {
  COUR_SUPREME
  COUR_APPEL_CENTRE
  COUR_APPEL_LITTORAL
  COUR_APPEL_OUEST
  COUR_APPEL_NORD_OUEST
  COUR_APPEL_SUD_OUEST
  TRIBUNAL_GRANDE_INSTANCE
  TRIBUNAL_PREMIERE_INSTANCE
  TRIBUNAL_COUTUMIER
}

enum MatiereDroit {
  CIVIL
  PENAL
  COMMERCIAL
  TRAVAIL
  ADMINISTRATIF
  FONCIER
  FAMILLE
  SUCCESSION
}

enum SensDecision {
  FAVORABLE
  DEFAVORABLE
  MIXTE
}

model Procedure {
  id               String           @id @default(uuid())
  dossierId        String
  typeProcedure    TypeProcedure
  juridiction      String
  numeroRG         String? // Numéro Rôle Général
  dateIntroduction DateTime
  montantReclame   Decimal?
  etapeActuelle    String
  etapes           EtapeProcedure[]
  statut           StatutProcedure  @default(EN_COURS)
  creeLe           DateTime         @default(now())
  modifieLe        DateTime         @updatedAt

  dossier   Dossier              @relation(fields: [dossierId], references: [id])
  audiences Audience[]
  pieces    PieceJustificative[]

  @@index([dossierId])
  @@index([statut])
}

model EtapeProcedure {
  id            String      @id @default(uuid())
  procedureId   String
  nom           String
  description   String?
  dateDebut     DateTime
  dateFin       DateTime?
  delaiLegal    Int? // en jours
  statut        StatutEtape @default(EN_COURS)
  responsableId String?
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  procedure Procedure @relation(fields: [procedureId], references: [id])

  @@index([procedureId])
}

model Audience {
  id            String         @id @default(uuid())
  procedureId   String
  dateAudience  DateTime
  heureAudience String
  salle         String?
  objet         String
  avocat        String?
  resultat      String?
  prochaineDate DateTime?
  statut        StatutAudience @default(PREVUE)
  creeLe        DateTime       @default(now())
  modifieLe     DateTime       @updatedAt

  procedure Procedure @relation(fields: [procedureId], references: [id])

  @@index([procedureId])
  @@index([dateAudience])
}

model PieceJustificative {
  id          String      @id @default(uuid())
  procedureId String
  nom         String
  type        TypePiece
  dateDepot   DateTime
  numeroDepot String?
  documentUrl String
  statut      StatutPiece @default(DEPOSEE)
  creeLe      DateTime    @default(now())
  modifieLe   DateTime    @updatedAt

  procedure Procedure @relation(fields: [procedureId], references: [id])

  @@index([procedureId])
}

enum TypeProcedure {
  ASSIGNATION
  REQUETE
  APPEL
  POURVOI_CASSATION
  REFERE
  ORDONNANCE_INJONCTION
}

enum StatutProcedure {
  EN_COURS
  SUSPENDUE
  TERMINEE
  RADIEE
}

enum StatutEtape {
  EN_ATTENTE
  EN_COURS
  TERMINEE
  BLOQUEE
}

enum StatutAudience {
  PREVUE
  TENUE
  REPORTEE
  ANNULEE
}

enum TypePiece {
  ASSIGNATION
  CONCLUSIONS
  PIECE_JUSTIFICATIVE
  EXPERTISE
  JUGEMENT
  ORDONNANCE
  AUTRE
}

enum StatutPiece {
  DEPOSEE
  ENREGISTREE
  SIGNIFIEE
}

model ModeleDocument {
  id           String          @id @default(uuid())
  nom          String          @unique
  categorie    CategorieModele
  typeDossier  TypeDossier?
  contenu      String          @db.Text
  variables    Json // Variables dynamiques
  langue       String          @default("FR")
  version      Int             @default(1)
  actif        Boolean         @default(true)
  utilisations Int             @default(0)
  creeLe       DateTime        @default(now())
  modifieLe    DateTime        @updatedAt

  documentsGeneres DocumentGenere[]

  @@index([categorie])
  @@index([typeDossier])
}

model DocumentGenere {
  id         String   @id @default(uuid())
  modeleId   String
  dossierId  String
  documentId String?
  variables  Json // Valeurs des variables
  creePar    String
  creeLe     DateTime @default(now())

  modele   ModeleDocument @relation(fields: [modeleId], references: [id])
  dossier  Dossier        @relation(fields: [dossierId], references: [id])
  document Document?      @relation(fields: [documentId], references: [id])

  @@index([dossierId])
  @@index([modeleId])
}

enum CategorieModele {
  ASSIGNATION
  CONCLUSIONS
  REQUETE
  ATTESTATION
  COURRIER_CLIENT
  CONTRAT
  CONVENTION
  POUVOIR
  AUTRE
}

model StatistiqueCabinet {
  id                     String   @id @default(uuid())
  date                   DateTime @default(now())
  nombreDossiers         Int
  dossiersOuverts        Int
  dossiersFermes         Int
  chiffreAffaires        Decimal
  honorairesMoyens       Decimal
  tauxRecouvrement       Decimal
  chargesTravail         Json // Par avocat
  performanceAvocats     Json
  delaisMoyenTraitement  Decimal
  tauxSatisfactionClient Decimal?
  creeLe                 DateTime @default(now())

  @@index([date])
}

model PerformanceAvocat {
  id                 String   @id @default(uuid())
  avocatId           String
  mois               DateTime
  nombreDossiers     Int
  chiffreAffaires    Decimal
  tauxVictoire       Decimal?
  delaiMoyen         Decimal
  satisfactionClient Decimal?
  creeLe             DateTime @default(now())

  avocat Utilisateur @relation(fields: [avocatId], references: [id])

  @@unique([avocatId, mois])
}

model Alerte {
  id             String         @id @default(uuid())
  type           TypeAlerte
  priorite       PrioriteAlerte
  titre          String
  message        String
  cibleId        String // Dossier, Facture, etc.
  typeCible      String
  utilisateurId  String?
  dateEcheance   DateTime?
  traite         Boolean        @default(false)
  dateTraitement DateTime?
  creeLe         DateTime       @default(now())

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([traite])
  @@index([type])
}

enum TypeAlerte {
  ECHEANCE_PROCEDURE
  PAIEMENT_RETARD
  PROVISION_FAIBLE
  AUDIENCE_PROCHE
  DOCUMENT_MANQUANT
  TACHE_URGENTE
  RENOUVELLEMENT_MANDAT
}

enum PrioriteAlerte {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

enum NiveauRisque {
  TRES_FAIBLE
  FAIBLE
  MOYEN
  ELEVE
  TRES_ELEVE
}

model CommunicationClient {
  id          String              @id @default(uuid())
  clientId    String
  type        TypeCommunication
  canal       CanalCommunication
  contenu     String
  statut      StatutCommunication
  dateEnvoi   DateTime?
  dateLecture DateTime?
  creeLe      DateTime            @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([statut])
}

enum TypeCommunication {
  RAPPEL_RDVRENDEZ_VOUS
  RAPPEL_PAIEMENT
  MISE_A_JOUR_DOSSIER
  DOCUMENT_PRET
  CONVOCATION
}

enum CanalCommunication {
  SMS
  WHATSAPP
  EMAIL
  APPEL
}

enum StatutCommunication {
  EN_ATTENTE
  ENVOYE
  DELIVRE
  LU
  ECHEC
}

model Satisfaction {
  id             String   @id @default(uuid())
  clientId       String
  dossierId      String?
  note           Int // 1-5 étoiles
  commentaire    String?
  dimensions     Json // Rapidité, qualité, communication, etc.
  dateEvaluation DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  dossier Dossier? @relation(fields: [dossierId], references: [id])

  @@index([clientId])
  @@index([note])
}

model Counter {
  key   String @id // Clé unique, ex: "SC240521" pour un dossier du 21/05/2024, "F202405" pour une facture de mai 2024
  value Int    @default(0) // La valeur actuelle du compteur

  @@map("counters") // Nom de la table en base de données
}
